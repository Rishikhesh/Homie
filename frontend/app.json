{
  "expo": {
    "name": "Doorman",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rentwise",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.rentwise.rr6gw5",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap repair photos so the right fix arrives",
        "NSPhotoLibraryUsageDescription": "Share repair photos and receipts with Doorman",
        "NSMicrophoneUsageDescription": "Talk to Doorman and record room videos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.rentwise.rr6gw5",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "@react-native-vector-icons/ionicons",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Share repair photos and receipts with Doorman",
          "cameraPermission": "Snap repair photos so the right fix arrives"
        }
      ],
      "expo-video",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
